<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect .php to trailing slash
RewriteCond %{THE_REQUEST} \s/blog/([^.]+)\.php [NC]
RewriteRule ^(.*)\.php$ /blog/$1/ [R=301,L]

# Redirect non-trailing slash to trailing slash (except for existing files/dirs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /blog/$1/ [L,R=301]

# Internally map trailing slash to .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)/$ $1.php [L]

</IfModule>
